# Backend API Configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slideai

# Cloudflare R2 Storage (for exports)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=slideai-exports

# Google Analytics Data API for /ops revenue funnel
GA4_PROPERTY_ID=522895745
# Recommended in production: paste the full service account JSON in one variable.
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Alternative split format:
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=slideai-analytics@gen-lang-client-0484766596.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
