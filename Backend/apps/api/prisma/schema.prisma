// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Utilise Supabase Postgres
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  memberships Membership[]
  projects   Project[]
  subscription Subscription?
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Membership[]
  projects  Project[]
}

model Membership {
  id        String   @id @default(cuid())
  role      String   // 'owner' | 'admin' | 'member'
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@index([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  ownerId     String
  orgId       String?
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
  org   Org? @relation(fields: [orgId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orgId     String?
  action    String
  target    String?
  ip        String?
  ua        String?
  traceId   String?
  createdAt DateTime  @default(now())
}

// === SUBSCRIPTION SYSTEM ===
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free") // 'free', 'starter', 'pro', 'business'
  status               String    @default("active") // 'active', 'canceled', 'past_due'
  creditsRemaining     Int       @default(1)        // Crédits de génération restants ce mois
  creditsResetAt       DateTime?                     // Date de reset des crédits
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === PRESENTATIONS ===
model Presentation {
  id                String   @id @default(uuid())
  user_id           String   // Links to Supabase Auth user ID (owner)
  title             String
  slides            Json     // Full deck JSON including slides array
  theme             String?
  status            String   @default("ready") // 'processing', 'ready', 'failed'
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // === SHARING (EDIT MODE) ===
  sharedWithUserIds String[] @default([]) @map("shared_with_user_ids") // User IDs who can view/edit
  shareToken        String?  @unique @map("share_token")              // Secret token for edit share link

  // === SHARING (VIEW-ONLY MODE) ===
  viewOnlyUserIds   String[] @default([]) @map("view_only_user_ids")  // User IDs with read-only access
  viewOnlyToken     String?  @unique @map("view_only_token")          // Secret token for view-only share link

  @@map("presentations") // Map to snake_case table name
}

