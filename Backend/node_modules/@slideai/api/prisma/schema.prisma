// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Utilise Supabase Postgres
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  memberships Membership[]
  projects   Project[]
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Membership[]
  projects  Project[]
}

model Membership {
  id        String   @id @default(cuid())
  role      String   // 'owner' | 'admin' | 'member'
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@index([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  ownerId     String
  orgId       String?
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
  org   Org? @relation(fields: [orgId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orgId     String?
  action    String
  target    String?
  ip        String?
  ua        String?
  traceId   String?
  createdAt DateTime  @default(now())
}
